    {
      "sql": "SELECT DISTINCT v.*,\n    (SELECT o.main_name FROM organizations o WHERE o.id = v.maker_organization_id) AS maker,\n    (SELECT o.main_name FROM organizations o WHERE o.id = v.publisher_organization_id) AS publisher,\n    (SELECT s.main_name FROM series s WHERE s.id = v.series_id) AS series,\n    (SELECT d.main_name FROM directors d WHERE d.id = v.director_id) AS director,\n    EXISTS (\n      SELECT 1 FROM pending_video_scrapes pvs WHERE pvs.video_id = v.id\n    ) AS has_pending_scrape,\n    (SELECT vr.kind\n     FROM video_resources vr\n     WHERE vr.video_id = v.id AND vr.is_primary = 1\n     ORDER BY vr.id ASC\n     LIMIT 1) AS primary_resource_kind,\n    (SELECT COUNT(*)\n     FROM video_resources vr\n     WHERE vr.video_id = v.id) AS resource_count,\n    (SELECT group_concat(resource_kind, ',')\n     FROM (\n       SELECT vr.kind AS resource_kind,\n              MAX(vr.is_primary) AS has_primary,\n              MIN(vr.add_time) AS first_added,\n              MIN(vr.id) AS first_id\n       FROM video_resources vr\n       WHERE vr.video_id = v.id\n       GROUP BY vr.kind\n       ORDER BY has_primary DESC, first_added ASC, first_id ASC\n     )) AS resource_kinds_csv FROM videos v  \n       ORDER BY (v.release_date IS NULL OR trim(v.release_date) = '') ASC, v.release_date DESC, v.add_time DESC\n       LIMIT ? OFFSET ?",
