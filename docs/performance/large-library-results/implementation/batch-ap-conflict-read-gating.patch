+import assert from 'node:assert/strict'
+import { it } from 'node:test'
+import React from 'react'
+import TestRenderer, { act } from 'react-test-renderer'
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
+import type { ActressNameConflictGroup } from '@shared/actressConflictTypes'
+import type { ConflictReviewViewModel } from './useConflictReviewController'
+Object.defineProperty(globalThis,'React',{configurable:true,value:React})
+const candidate = {
+  pendingId: 10,
+  revision: 1,
+  actressId: 2,
+  actressRevision: 3,
+  actressMainName: '候选演员',
+  actressAvatarPath: null,
+  plugin: { id: 'test', name: 'Test', version: '1' },
+  queryName: '候选演员',
+  selectedFields: ['aliases'],
+  applicableFields: ['aliases'],
+  mode: 'fillEmpty' as const,
+  result: { aliases: ['冲突名'] },
+  warnings: [],
+  createdAt: '2026-08-07T00:00:00.000Z',
+  resources: [],
+  conflicts: [{ name: '冲突名', normalizedName: '冲突名', type: 'alias' as const }],
+  fieldImpactsWhenAssignedToCandidate: [],
+  fieldImpacts: [],
+  willApplyAfterDecision: true,
+  remainingConflictCountAfterDecision: 0
+}
+
+function group(withMainClaimant = false): ActressNameConflictGroup {
+  return {
+    status: 'conflict',
+    normalizedName: '冲突名',
+    displayName: '冲突名',
+    currentOwner: withMainClaimant
+      ? {
+          actressId: 1,
+          revision: 4,
+          mainName: '冲突名',
+          avatarPath: null,
+          nameTypes: ['main'],
+          hasPendingScrape: false
+        }
+      : null,
+    claimants: withMainClaimant
+      ? [
+          {
+            actressId: 1,
+            revision: 4,
+            mainName: '冲突名',
+            avatarPath: null,
+            nameTypes: ['main'],
+            hasPendingScrape: false
+          }
+        ]
+      : [],
+    pendingNameClaims: [],
+    candidates: [candidate] as unknown as ActressNameConflictGroup['candidates'],
+    mergePairs: []
+  }
+}
+
+
+it('preserves an explicit ownership decision while detail reads are disabled and reenabled',async()=>{
+ let reads=0
+ const fixture=group()
+ Object.defineProperty(globalThis,'window',{configurable:true,value:{api:{actressScrape:{listConflicts:async()=>{reads++;return [fixture]},conflictSummary:async()=>({groupCount:1})}}}})
+ const {useConflictReviewController}=await import('./useConflictReviewController')
+ let vm!:ConflictReviewViewModel
+ function Probe({enabled}:{enabled:boolean}):null{vm=useConflictReviewController({enabled,summaryEnabled:enabled});return null}
+ const client=new QueryClient({defaultOptions:{queries:{retry:false}}})
+ let renderer:TestRenderer.ReactTestRenderer|undefined
+ const tree=(enabled:boolean)=><QueryClientProvider client={client}><Probe enabled={enabled}/></QueryClientProvider>
+ const settle=async()=>{await act(async()=>{await new Promise(resolve=>setTimeout(resolve,20))})}
+ try{
+  await act(async()=>{renderer=TestRenderer.create(tree(true))});await settle();await settle()
+  await act(async()=>vm.queue.chooseGroup(fixture));await settle()
+  await act(async()=>vm.detail.selectOwner({actressId:2,revision:3,mainName:'候选演员'}));await settle()
+  assert.equal(vm.detail.selection?.proposedOwner?.actressId,2)
+  const priorReads=reads
+  await act(async()=>renderer!.update(tree(false)));await settle()
+  assert.equal(reads,priorReads)
+  assert.equal(vm.detail.selection?.proposedOwner?.actressId,2)
+  assert.equal(vm.queue.selectedGroup?.normalizedName,'冲突名')
+  await act(async()=>renderer!.update(tree(true)));await settle();await settle()
+  assert.equal(vm.detail.selection?.proposedOwner?.actressId,2)
+ }finally{await act(async()=>renderer?.unmount());client.clear()}
+})
