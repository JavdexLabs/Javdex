+  api: {}, location: { href: 'http://localhost/' }, history: { state: null, pushState() {} }
+}) })
+let renderer: TestRenderer.ReactTestRenderer | undefined
+afterEach(async () => { await act(async () => renderer?.unmount()); renderer = undefined })
