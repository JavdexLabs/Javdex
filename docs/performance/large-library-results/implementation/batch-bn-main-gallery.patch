+
+let root: string
+let previous: string | undefined
+beforeEach(() => {
+  root = fs.mkdtempSync(path.join(os.tmpdir(), 'javdex-gallery-page-'))
+  previous = process.env.JAVDEX_TEST_USER_DATA
+  process.env.JAVDEX_TEST_USER_DATA = root
