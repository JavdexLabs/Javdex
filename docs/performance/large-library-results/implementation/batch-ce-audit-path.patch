+      const query=normalizeAuditPathRequest(libraryId,filePath)
+      return this.enqueue({operation:'scan-audit-path',query},['scan-audit-path',query],signal) as Promise<boolean>
+    } catch (error) { return Promise.reject(error) }
+  }
