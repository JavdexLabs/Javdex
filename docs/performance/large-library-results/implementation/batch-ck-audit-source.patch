@@ -0,0 +1,46 @@
+import type Database from 'better-sqlite3'
+
+export type ScanAuditSourceSelection =
+  | { libraryId: number; runId: string }
+  | { libraryId: number; latest: true }
+
+interface JsonAuditSource {
+  format: 'json'
+  libraryId: number
+  runId: string
+}
+
+export function readScanAuditSource(
+  db: Database.Database, selection: ScanAuditSourceSelection, projection: 'identity'
+): JsonAuditSource | undefined
+export function readScanAuditSource(
+  db: Database.Database, selection: ScanAuditSourceSelection, projection: 'bytes'
+): (JsonAuditSource & { bytes: number }) | undefined
+export function readScanAuditSource(
+  db: Database.Database, selection: ScanAuditSourceSelection, projection: 'body'
+): (JsonAuditSource & { body: string }) | undefined
+/**
+ * Select stored audit data without changing each caller's run-selection policy.
+ * Legacy availability is non-NULL JSON, including malformed/empty bodies and
+ * nonterminal historical rows. Validation stays at the reader boundary.
+ * Call inside the reader's transaction when subsequent queries need its snapshot.
+ * Identity/byte projections never return the full body to JavaScript.
+ */
+export function readScanAuditSource(
+  db: Database.Database,
+  selection: ScanAuditSourceSelection,
+  projection: 'identity' | 'bytes' | 'body'
+): (JsonAuditSource & { bytes?: number; body?: string }) | undefined {
+  const columns = projection === 'body' ? 'id,audit_json AS body'
+    : projection === 'bytes' ? 'id,length(CAST(audit_json AS BLOB)) AS bytes' : 'id'
+  const exact = 'runId' in selection
+  const row = db.prepare(`SELECT ${columns} FROM library_scan_runs
+    WHERE library_id=? AND audit_json IS NOT NULL${exact ? ' AND id=?' : ' ORDER BY started_at DESC,id DESC LIMIT 1'}`)
+    .get(...(exact ? [selection.libraryId, selection.runId] : [selection.libraryId])) as
+      { id: string; bytes?: number; body?: string } | undefined
+  if (!row) return undefined
+  const source: JsonAuditSource = { format: 'json', libraryId: selection.libraryId, runId: row.id }
+  if (projection === 'body') return { ...source, body: row.body! }
+  if (projection === 'bytes') return { ...source, bytes: row.bytes! }
+  return source
+}
