+let directory:string, media:string, sequence=0
+let previousUserData:string|undefined
+beforeEach(()=>{
+  previousUserData=process.env.JAVDEX_TEST_USER_DATA
+  directory=fs.mkdtempSync(path.join(os.tmpdir(),'javdex-scanner-sink-'))
