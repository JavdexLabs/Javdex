+  assert.equal(sawHuge, true)
+  assert.equal(db.inTransaction, false)
+  assert.deepEqual(db.prepare("SELECT name FROM sqlite_temp_master WHERE name LIKE 'pending_scan_audit_visit_%'").all(), [])
