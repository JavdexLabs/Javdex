{
  "name": "Javdex",
  "version": "0.4.0",
  "description": "Javdex — local JAV library manager",
  "main": "./out/main/index.js",
  "author": "Javdex",
  "license": "MIT",
  "private": false,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "pages:build": "node website/scripts/build.mjs",
    "pages:build:offline": "node website/scripts/build.mjs --offline",
    "pages:preview": "npm run pages:build && vite dist-pages",
    "build": "electron-vite build && node scripts/check-mediapipe-assets.mjs",
    "generate:icons": "python scripts/generate-app-icons.py",
    "packaging:list": "node scripts/dist.mjs --list",
    "packaging:configure": "node scripts/configure-packaging.mjs",
    "dist": "node scripts/dist.mjs",
    "dist:win": "node scripts/dist.mjs --platform win",
    "dist:mac": "node scripts/dist.mjs --platform mac",
    "dist:linux": "node scripts/dist.mjs --platform linux",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:actress-boundaries": "node scripts/check-actress-boundaries.mjs",
    "pretest": "npm run check:actress-boundaries",
    "test": "npm run typecheck && node scripts/run-electron-tests.mjs",
    "mcp:plugin-dev": "tsx src/mcp/javdex-plugin-dev-server.ts",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "@tanstack/react-query": "^5.101.0",
    "axios": "^1.7.7",
    "better-sqlite3": "^11.5.0",
    "cheerio": "^1.0.0",
    "https-proxy-agent": "^7.0.5",
    "lucide-react": "^1.21.0",
    "music-metadata": "^10.9.1",
    "react-markdown": "^10.1.0",
    "strtok3": "^10.3.5",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "@electron/osx-sign": "1.3.1",
    "@electron/rebuild": "^3.7.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "react-window": "^1.8.10",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
