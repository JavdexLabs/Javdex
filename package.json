{
  "name": "Javdex",
  "version": "0.9.0",
  "description": "Javdex — local JAV library manager",
  "main": "./out/main/index.js",
  "author": "Javdex",
  "license": "GPL-3.0-or-later",
  "private": false,
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "undici": "8.10.2",
      "minimatch": {
        "brace-expansion": "5.0.12"
      }
    },
    "postcss-nested": {
      "postcss-selector-parser": "7.1.6"
    }
  },
  "scripts": {
    "dev": "npm run web:build && node scripts/dev.mjs",
    "pages:build": "node website/scripts/build.mjs",
    "pages:build:offline": "node website/scripts/build.mjs --offline",
    "pages:preview": "npm run preview --workspace @javdex/website",
    "pages:dev": "npm run dev --workspace @javdex/website",
    "pages:test": "node --test website/scripts/*.test.mjs",
    "pages:check": "node website/scripts/check.mjs",
    "build": "npm run desktop:build && npm run web:build",
    "generate:icons": "python scripts/generate-app-icons.py",
    "packaging:list": "node scripts/dist.mjs --list",
    "packaging:configure": "node scripts/configure-packaging.mjs",
    "packaging:verify-agent-runtime": "node scripts/check-packaged-agent-runtime.mjs",
    "packaging:verify-playback-runtime": "node scripts/check-packaged-playback-runtime.mjs",
    "test:packaging": "node --test scripts/packaging-runtime.test.mjs scripts/playback-runtime.test.mjs scripts/playback-linux-elf.test.mjs scripts/aggregate-playback-sources.test.mjs scripts/check-playback-installers.test.mjs scripts/linux-release-materials.test.mjs scripts/ai-runtime-download.test.mjs scripts/renderer-bundle-report.test.mjs scripts/patch-sharp-electron.test.mjs",
    "test:playback:fixtures": "node --test scripts/playback-pgs-fixture.test.mjs scripts/linux-color-reference.test.mjs scripts/linux-frame-timing.test.mjs",
    "test:playback:build": "node --test scripts/playback-native-build.test.mjs scripts/playback-source-build.test.mjs scripts/stage-playback-linux-context.test.mjs scripts/release-metadata.test.mjs scripts/release-publication.test.mjs scripts/release-replacement.test.mjs scripts/release-replacement-process.test.mjs && node --import tsx --test scripts/playback-acceptance-settings.test.mjs",
    "test:backup-smoke": "node --test scripts/backup-smoke-status.test.mjs",
    "test:playback:navigation": "node scripts/playback-navigation-acceptance.mjs",
    "test:playback:remote": "node --require ./scripts/register-test-paths.cjs --import tsx scripts/playback-remote-acceptance.mjs",
    "test:playback:remote:connection": "node --require ./scripts/register-test-paths.cjs --import tsx scripts/playback-remote-connection-smoke.mts",
    "test:ui": "node scripts/test-ui.mjs && node scripts/ai-subtitle-guide-check.mjs && node scripts/modal-stability-check.mjs && node scripts/playback-settings-ui-check.mjs && node scripts/model-providers-ui-check.mjs",
    "test:ui:server-update": "node scripts/server-update-ui-check.mjs",
    "test:ui:matrix": "node scripts/css-module-migration.mjs",
    "measure:renderer": "node scripts/renderer-bundle-report.mjs",
    "smoke:scraper-helper": "npm run build && electron . --javdex-scraper-helper-smoke",
    "dist": "node scripts/dist.mjs",
    "dist:win": "node scripts/dist.mjs --platform win",
    "dist:win:local": "node scripts/dist.mjs --platform win --local-playback",
    "dist:mac": "node scripts/dist.mjs --platform mac",
    "dist:linux": "node scripts/dist.mjs --platform linux",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "prototype:libmpv": "node scripts/libmpv-prototype.mjs",
    "playback:native:build": "node scripts/build-playback-native.mjs",
    "playback:runtime:build": "node scripts/build-playback-runtime.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false && tsc --noEmit -p tsconfig.browser.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:actress-boundaries": "node scripts/check-actress-boundaries.mjs",
    "check:media-asset-store-boundaries": "node scripts/check-media-asset-store-boundaries.mjs",
    "check:metadata-source-boundaries": "node scripts/check-metadata-source-boundaries.mjs",
    "check:classification-entity-boundaries": "node scripts/check-classification-entity-boundaries.mjs",
    "check:library-boundaries": "node scripts/check-library-boundaries.mjs",
    "check:http-boundaries": "node scripts/check-http-boundaries.mjs",
    "check:http-node-load": "node scripts/check-http-node-load.mjs",
    "check:desktop-architecture": "node scripts/check-desktop-architecture.mjs && node --test scripts/catalog-query-boundary.test.mjs",
    "check:agent-platform-boundaries": "node scripts/check-agent-platform-boundaries.mjs",
    "lint:ts": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" \"electron.vite.config.ts\"",
    "lint:css": "stylelint \"apps/desktop/src/renderer/src/**/*.module.css\" \"apps/web/src/**/*.module.css\" \"packages/ui/src/**/*.module.css\" --allow-empty-input",
    "lint": "npm run lint:ts && npm run lint:css",
    "check:css-architecture": "node scripts/check-css-architecture.mjs",
    "check:ui-controls": "node scripts/check-ui-controls.mjs",
    "pretest": "npm run check:workspaces && npm run check:library-boundaries && npm run check:http-boundaries && npm run check:http-node-load && npm run check:server-boundaries && npm run check:desktop-architecture && npm run check:actress-boundaries && npm run check:media-asset-store-boundaries && npm run check:metadata-source-boundaries && npm run check:classification-entity-boundaries && npm run check:agent-platform-boundaries && npm run lint && npm run check:css-architecture && npm run check:ui-controls",
    "test": "npm run typecheck && npm run test:packaging && npm run test:playback:fixtures && npm run test:playback:build && npm run test:backup-smoke && node scripts/run-electron-tests.mjs",
    "mcp:plugin-dev": "tsx apps/desktop/src/mcp/javdex-plugin-dev-server.ts",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "web:build": "vite build --config vite.web.config.ts",
    "web:check:mobile": "npm run web:build && node scripts/check-mobile-web.mjs",
    "web:dev": "vite build --config vite.web.config.ts --watch",
    "desktop:build": "electron-vite build && node scripts/check-mediapipe-assets.mjs && node scripts/check-built-pi-runtime.mjs && npm run measure:renderer",
    "setup:desktop": "electron-rebuild -f -w better-sqlite3",
    "check:workspaces": "node scripts/check-workspaces.mjs && node --test scripts/check-workspaces.test.mjs",
    "check:server-boundaries": "node scripts/check-server-boundaries.mjs",
    "check:server-production-closure": "node scripts/check-server-production-closure.mjs",
    "server:build": "npm run web:build && node scripts/server-build.mjs && node scripts/check-server-production-closure.mjs",
    "server:updater:build": "node scripts/updater-build.mjs",
    "server:updater:smoke": "node --require ./scripts/register-test-paths.cjs --import tsx scripts/server-updater-smoke.ts",
    "server:updater:test": "node --require ./scripts/register-test-paths.cjs --import tsx --test apps/server/src/updater/*.test.ts apps/server/src/updateGuard.test.ts packages/http/src/updateClient.test.ts packages/http/src/updateBundle.test.ts packages/http/src/pinnedFetch.test.ts packages/http/src/serverEnvironmentClient.test.ts packages/contracts/src/serverEnvironment.test.ts scripts/server-release-package.test.mjs scripts/server-update-release.test.mjs scripts/server-updater-smoke-legacy.test.mts",
    "server:test": "npm run check:server-boundaries && node scripts/server-test.mjs",
    "server:smoke": "node --import tsx scripts/server-smoke.mjs",
    "server:smoke:agent": "node scripts/run-electron-tests.mjs apps/desktop/src/main/services/agentMetadata/agentMetadataDocker.smoke.ts",
    "server:smoke:node": "node scripts/run-server-smoke.mjs node",
    "server:smoke:backup": "node --import tsx scripts/backup-docker-smoke.mjs",
    "smoke:same-version-install": "node scripts/same-version-install-smoke.mjs",
    "typecheck:browser": "tsc --noEmit -p tsconfig.browser.json",
    "postinstall": "node scripts/patch-sharp-electron.mjs",
    "prepare:sharp": "node scripts/patch-sharp-electron.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@img/sharp-wasm32": "0.35.5",
    "acorn": "8.18.0",
    "axios": "^1.20.0",
    "better-sqlite3": "13.0.3",
    "cheerio": "^1.0.0",
    "fast-xml-parser": "5.11.1",
    "https-proxy-agent": "^7.0.5",
    "music-metadata": "^11.16.0",
    "playwright-core": "1.62.1",
    "qrcode": "^1.5.4",
    "semver": "7.8.5",
    "sharp": "0.35.5",
    "socks": "2.8.9",
    "strtok3": "^10.3.5",
    "tar": "7.5.22",
    "undici": "^7.29.1",
    "yet-another-react-lightbox": "^3.32.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/osx-sign": "1.3.1",
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^9.39.5",
    "@mediapipe/tasks-vision": "0.10.35",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@tanstack/react-query": "^5.101.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-test-renderer": "^18.3.1",
    "@types/react-window": "^1.8.8",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "43.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "lucide-react": "^1.21.0",
    "postcss": "^8.5.26",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "react-test-renderer": "^18.3.1",
    "react-window": "^1.8.10",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^38.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "website"
  ]
}
