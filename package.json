{
  "name": "Javdex",
  "version": "0.5.0",
  "description": "Javdex — local JAV library manager",
  "main": "./out/main/index.js",
  "author": "Javdex",
  "license": "MIT",
  "private": false,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "pages:build": "node website/scripts/build.mjs",
    "pages:build:offline": "node website/scripts/build.mjs --offline",
    "pages:preview": "npm run pages:build && vite dist-pages",
    "build": "electron-vite build && node scripts/check-mediapipe-assets.mjs && node scripts/check-built-pi-runtime.mjs",
    "generate:icons": "python scripts/generate-app-icons.py",
    "packaging:list": "node scripts/dist.mjs --list",
    "packaging:configure": "node scripts/configure-packaging.mjs",
    "packaging:verify-agent-runtime": "node scripts/check-packaged-agent-runtime.mjs",
    "test:packaging": "node --test scripts/packaging-runtime.test.mjs",
    "smoke:scraper-helper": "npm run build && electron . --javdex-scraper-helper-smoke",
    "dist": "node scripts/dist.mjs",
    "dist:win": "node scripts/dist.mjs --platform win",
    "dist:mac": "node scripts/dist.mjs --platform mac",
    "dist:linux": "node scripts/dist.mjs --platform linux",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:actress-boundaries": "node scripts/check-actress-boundaries.mjs",
    "check:media-asset-store-boundaries": "node scripts/check-media-asset-store-boundaries.mjs",
    "check:classification-entity-boundaries": "node scripts/check-classification-entity-boundaries.mjs",
    "check:agent-platform-boundaries": "node scripts/check-agent-platform-boundaries.mjs",
    "lint:ts": "eslint \"src/**/*.{ts,tsx}\" \"electron.vite.config.ts\"",
    "lint:css": "stylelint \"src/renderer/src/**/*.module.css\" --allow-empty-input",
    "lint": "npm run lint:ts && npm run lint:css",
    "check:css-architecture": "node scripts/check-css-architecture.mjs",
    "pretest": "npm run check:actress-boundaries && npm run check:media-asset-store-boundaries && npm run check:classification-entity-boundaries && npm run check:agent-platform-boundaries && npm run lint && npm run check:css-architecture",
    "test": "npm run typecheck && npm run test:packaging && node scripts/run-electron-tests.mjs",
    "mcp:plugin-dev": "tsx src/mcp/javdex-plugin-dev-server.ts",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "acorn": "8.18.0",
    "axios": "^1.7.7",
    "better-sqlite3": "13.0.3",
    "cheerio": "^1.0.0",
    "https-proxy-agent": "^7.0.5",
    "music-metadata": "^11.14.0",
    "playwright-core": "1.62.1",
    "socks": "2.8.9",
    "strtok3": "^10.3.5",
    "undici": "^7.28.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/osx-sign": "1.3.1",
    "@electron/rebuild": "^3.7.1",
    "@mediapipe/tasks-vision": "0.10.35",
    "@tanstack/react-query": "^5.101.0",
    "@eslint/js": "^9.39.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-test-renderer": "^18.3.1",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "43.4.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "lucide-react": "^1.21.0",
    "postcss": "^8.5.26",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "react-test-renderer": "^18.3.1",
    "react-window": "^1.8.10",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^38.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.4.11"
  }
}
