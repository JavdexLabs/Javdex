{
  "include": [
    "apps/desktop/src/renderer/src/**/*",
    "apps/desktop/src/renderer/src/**/*.tsx",
    "packages/contracts/src/**/*",
    "packages/ui/src/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./out-tsc/web",
    "baseUrl": ".",
    "paths": {
      "@renderer/*": [
        "apps/desktop/src/renderer/src/*"
      ],
      "@shared/*": [
        "packages/contracts/src/*"
      ],
      "@library/*": [
        "packages/library/src/*"
      ]
    }
  }
}
