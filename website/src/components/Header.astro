---
import DefaultHeader from '@astrojs/starlight/components/Header.astro';
import ThemeSelect from './ThemeSelect.astro';
import { sitePath } from '../../site.config.mjs';
const links = [
  ['快速上手', 'getting-started/overview/'],
  ['使用指南', 'guides/library-and-scanning/'],
  ['NAS 与服务端', 'server/deploy/'],
  ['插件与开发', 'plugins/overview-and-agent/'],
  ['下载中心', 'download/'],
];
---
<div class="header-shell">
  <DefaultHeader {...Astro.props} />
  <nav class="top-nav" aria-label="网站导航">
    {links.map(([label, target]) => <a href={sitePath(target)} draggable="false" aria-current={Astro.url.pathname.startsWith(sitePath(target)) ? 'page' : undefined}>{label}</a>)}
    <div class="mobile-theme"><ThemeSelect /></div>
  </nav>
</div>
