---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { sitePath } from '../../site.config.mjs';
const paths = [
  ['01 / 桌面本地', '在个人电脑开始', '安装、建库、扫描与播放。零依赖极速建库。', 'getting-started/quickstart/'],
  ['02 / 服务端', '部署到 NAS / 服务器', '单个 Docker 容器持久化，支持多电脑 HTTPS 授权与浏览器只读浏览。', 'server/deploy/'],
  ['03 / 数据运维', '升级与备份迁移', '跨端互相导入、跨系统路径重写、无缝平滑升级。', 'operations/upgrade-and-compatibility/'],
];
const tasks = [
  ['整理与扫描', 'guides/library-and-scanning/'],
  ['消解待办冲突', 'guides/pending-and-curation/'],
  ['配置刮削来源', 'guides/metadata-scraping/'],
  ['NFO 互通与导出', 'guides/nfo-migration-and-export/'],
  ['演员与人脸裁切', 'guides/actresses-and-facets/'],
  ['内置播放器', 'guides/playback/'],
  ['实时 AI 日中字幕', 'guides/ai-subtitles-and-models/'],
  ['局域网多端访问', 'guides/lan-web-access/'],
  ['防窥与图片加密', 'guides/privacy-and-storage/'],
  ['备份恢复与迁移', 'operations/backup-and-migration/'],
];
---
<StarlightPage frontmatter={{ title: 'Javdex 官方文档', description: '本地优先的开源影片资料库，从桌面建库到 NAS 部署、AI 字幕与 NFO 互通。', template: 'splash', editUrl: false }}>
  <p class="portal-lead">以番号为核心，把影片文件、资源链接与人物资料整理成私人媒体库。<br />本地优先 · 桌面与 Docker 双模式 · libmpv 原生播放 · 端侧 AI 日中字幕 · 完整 NFO 生态互通</p>
  <div class="portal-paths not-content">
    {paths.map(([number, title, copy, target]) => <a class="portal-path" href={sitePath(target)} draggable="false"><span>{number}</span><strong>{title} →</strong><p>{copy}</p></a>)}
  </div>
  <section aria-labelledby="common-tasks"><h2 id="common-tasks">核心工作流指南</h2><div class="task-links not-content">{tasks.map(([label, target]) => <a href={sitePath(target)}>{label} →</a>)}</div></section>
  <section class="portal-about" aria-labelledby="about-site"><h2 id="about-site">了解更多</h2><p><a id="product" href={sitePath('product/')}>查看产品介绍与真实截图</a> · <a id="download" href={sitePath('download/')}>下载中心</a> · <a id="workflow" href={sitePath('getting-started/overview/')}>产品架构与定位</a> · <a id="nfo" href={sitePath('guides/nfo-migration-and-export/')}>NFO 资料互通</a></p></section>
</StarlightPage>
